rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Existing: subscription status (read-only for authenticated user) ──
    match /users/{uid}/subscription/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Reminders: owner-only read/write. Location-type reminders are a Pro-only
    // feature in the client UI (reminder-form.component.ts disables the button
    // behind isPro()) — enforce it here too, since a free user could otherwise
    // write a location reminder directly via the Firestore SDK, bypassing the UI. ──
    match /users/{uid}/reminders/{reminderId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        (request.resource.data.type != 'location' || isProUser(uid));
    }

    // ── New: family document (read-only for members) ──
    match /families/{familyId} {
      allow read: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.partnerUid == request.auth.uid);
      allow write: if false; // Firebase Functions only
    }

    // ── New: family activity deltas (members read; author writes own delta) ──
    match /families/{familyId}/activity/{activityId} {
      allow read: if request.auth != null &&
        isFamilyMember(familyId);
      // Client writes their own delta directly (no Function needed for writes)
      allow create: if request.auth != null &&
        isFamilyMember(familyId) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.familyId == familyId;
      allow update, delete: if false; // deltas are immutable
    }

    // ── New: family state snapshot (full BackupDocument pushed by owner or partner) ──
    match /families/{familyId}/state/{docId} {
      allow read, write: if request.auth != null && isFamilyMember(familyId);
    }

    // ── New: family invites (owner reads their own; redeemer reads by code) ──
    match /familyInvites/{inviteCode} {
      allow read: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.redeemedAt == null);
      allow write: if false; // Firebase Functions only
    }

    // ── Google OAuth refresh tokens: SERVER ONLY (Cloud Functions via Admin SDK). ──
    // Clients must never read or write these — they hold long-lived Drive access.
    match /googleTokens/{uid} {
      allow read, write: if false;
    }

    // ── Helper ──
    function isFamilyMember(familyId) {
      let familyDoc = get(/databases/$(database)/documents/families/$(familyId));
      return familyDoc != null &&
             (familyDoc.data.ownerUid == request.auth.uid ||
              familyDoc.data.partnerUid == request.auth.uid);
    }

    function isProUser(uid) {
      let subPath = /databases/$(database)/documents/users/$(uid)/subscription/status;
      return exists(subPath) &&
             get(subPath).data.tier == 'pro' &&
             get(subPath).data.expiresAt is timestamp &&
             get(subPath).data.expiresAt > request.time;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
