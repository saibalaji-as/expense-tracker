rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Existing: subscription status (read-only for authenticated user) ──
    match /users/{uid}/subscription/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Reminders: owner-only read/write. Location-type reminders are a Pro-only
    // feature in the client UI (reminder-form.component.ts disables the button
    // behind isPro()) — enforce it here too, since a free user could otherwise
    // write a location reminder directly via the Firestore SDK, bypassing the UI. ──
    match /users/{uid}/reminders/{reminderId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        (request.resource.data.type != 'location' || isProUser(uid));
    }

    // ── New: family document (read-only for members) ──
    match /families/{familyId} {
      allow read: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.partnerUid == request.auth.uid);
      allow write: if false; // Firebase Functions only
    }

    // ── New: family activity deltas (members read; author writes own delta) ──
    match /families/{familyId}/activity/{activityId} {
      allow read: if request.auth != null &&
        isFamilyMember(familyId);
      // Client writes their own delta directly (no Function needed for writes)
      allow create: if request.auth != null &&
        isFamilyMember(familyId) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.familyId == familyId;
      allow update, delete: if false; // deltas are immutable
    }

    // ── LEGACY: family state snapshot (full BackupDocument). WRITE-LOCKED since
    // Phase 2 — the ledger is the only write path; this doc exists solely so a
    // fresh device with legacy data can migrate it into the ledger. Remove the
    // block (and the doc) once no legacy families remain. ──
    match /families/{familyId}/state/{docId} {
      allow read: if request.auth != null && isFamilyMember(familyId);
      allow write: if false;
    }

    // ── Family Ledger: one document per shared record (expense/adjustment/
    // debt-payment/account/debt + limits/meta singletons). Members read and
    // write; deletions are tombstones (deleted: true), never document deletes.
    // See docs/family-sync-centralization-plan.md. ──
    match /families/{familyId}/ledger/{recordId} {
      allow read, create, update: if request.auth != null && isFamilyMember(familyId);
      allow delete: if false; // tombstones only — history must survive
    }

    // ── New: family invites (owner reads their own; redeemer reads by code) ──
    match /familyInvites/{inviteCode} {
      allow read: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.redeemedAt == null);
      allow write: if false; // Firebase Functions only
    }

    // ── Circle Splits: N-member group expense sharing (docs/circle-splits-plan.md).
    // FREE tier by design — no Pro gate (growth loop). Circle docs are
    // Functions-only; membership/status changes are server-authoritative. ──
    match /circles/{circleId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.memberUids;
      allow write: if false; // Firebase Functions only
    }

    // ── Circle expenses: members read; author writes own records; tombstones
    // only (deleted: true) — no document deletes. Writes blocked once the
    // circle is settled. ──
    match /circles/{circleId}/expenses/{expenseId} {
      allow read: if request.auth != null && isCircleMember(circleId);
      allow create: if request.auth != null &&
        isActiveCircleMember(circleId) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.circleId == circleId &&
        request.resource.data.deleted == false;
      // Author edits/tombstones their own record; the circle owner may also
      // edit (cleanup of placeholder-member spends). authorUid is immutable.
      allow update: if request.auth != null &&
        isActiveCircleMember(circleId) &&
        request.resource.data.authorUid == resource.data.authorUid &&
        request.resource.data.circleId == circleId &&
        (resource.data.authorUid == request.auth.uid || isCircleOwner(circleId));
      allow delete: if false; // tombstones only
    }

    // ── Circle invites: multi-use Circle Link codes. Owner reads their own;
    // any signed-in user can read an unrevoked code to preview the circle
    // before joining. Writes: Functions only. ──
    match /circleInvites/{inviteCode} {
      allow read: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.revoked == false);
      allow write: if false; // Firebase Functions only
    }

    // ── Google OAuth refresh tokens: SERVER ONLY (Cloud Functions via Admin SDK). ──
    // Clients must never read or write these — they hold long-lived Drive access.
    match /googleTokens/{uid} {
      allow read, write: if false;
    }

    // ── Helper ──
    function isFamilyMember(familyId) {
      let familyDoc = get(/databases/$(database)/documents/families/$(familyId));
      return familyDoc != null &&
             (familyDoc.data.ownerUid == request.auth.uid ||
              familyDoc.data.partnerUid == request.auth.uid);
    }

    function isCircleMember(circleId) {
      let circleDoc = get(/databases/$(database)/documents/circles/$(circleId));
      return circleDoc != null && request.auth.uid in circleDoc.data.memberUids;
    }

    function isActiveCircleMember(circleId) {
      let circleDoc = get(/databases/$(database)/documents/circles/$(circleId));
      return circleDoc != null &&
             request.auth.uid in circleDoc.data.memberUids &&
             circleDoc.data.status == 'active';
    }

    function isCircleOwner(circleId) {
      let circleDoc = get(/databases/$(database)/documents/circles/$(circleId));
      return circleDoc != null && circleDoc.data.ownerUid == request.auth.uid;
    }

    function isProUser(uid) {
      let subPath = /databases/$(database)/documents/users/$(uid)/subscription/status;
      return exists(subPath) &&
             get(subPath).data.tier == 'pro' &&
             get(subPath).data.expiresAt is timestamp &&
             get(subPath).data.expiresAt > request.time;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
