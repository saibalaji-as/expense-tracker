<?xml version="1.0" encoding="utf-8"?>
<!-- Daily Streak widget, roomy tier (portrait height >= 150dp). Same ids as streak_widget.xml, scaled up for launchers with tall cells.
     Row 1: flame badge + streak count hero + status/best column.
     Row 2: 7-day dot tracker, centered in the leftover height.
     A single launcher row uses streak_widget_compact instead; badge/pill/dot
     drawables are swapped per app design style by StreakWidgetProvider. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/expense_widget_background">

    <ImageView
        android:id="@+id/widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/streak_widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="13dp"
        android:paddingRight="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/streak_flame_badge"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/streak_flame_badge"
                android:padding="12dp"
                android:src="@drawable/ic_widget_flame" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/streak_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="0"
                        android:textColor="@color/spenza_flame_end"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/streak_count_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_marginBottom="4dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="day streak"
                        android:textColor="@color/spenza_widget_muted"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/streak_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Log an expense to start your streak."
                    android:textColor="@color/spenza_widget_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/streak_status"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/streak_status_pill"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:paddingLeft="11dp"
                    android:paddingRight="11dp"
                    android:singleLine="true"
                    android:text="On track"
                    android:textColor="@color/spenza_food"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/streak_best"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_gravity="end"
                    android:singleLine="true"
                    android:text="Best 0"
                    android:textColor="@color/spenza_widget_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="7">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/streak_day0"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/streak_day_dot_off" />
                <TextView
                    android:id="@+id/streak_lbl0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="S"
                    android:textColor="@color/spenza_widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/streak_day1"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/streak_day_dot_off" />
                <TextView
                    android:id="@+id/streak_lbl1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="M"
                    android:textColor="@color/spenza_widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/streak_day2"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/streak_day_dot_off" />
                <TextView
                    android:id="@+id/streak_lbl2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="T"
                    android:textColor="@color/spenza_widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/streak_day3"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/streak_day_dot_off" />
                <TextView
                    android:id="@+id/streak_lbl3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="W"
                    android:textColor="@color/spenza_widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/streak_day4"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/streak_day_dot_off" />
                <TextView
                    android:id="@+id/streak_lbl4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="T"
                    android:textColor="@color/spenza_widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/streak_day5"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/streak_day_dot_off" />
                <TextView
                    android:id="@+id/streak_lbl5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="F"
                    android:textColor="@color/spenza_widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/streak_day6"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/streak_day_dot_today" />
                <TextView
                    android:id="@+id/streak_lbl6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="S"
                    android:textColor="@color/spenza_widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
