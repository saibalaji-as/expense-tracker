<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle highlight behind the predicted quick-action button so the most likely
     category stands out at a glance. Translucent so it reads on light and dark
     widget surfaces. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#226D5DFB" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#556D5DFB" />
</shape>
