{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "target": "spenza-site",
    "public": "dist/personal-finance-pwa/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/functions/registerToken",
        "function": "registerToken",
        "region": "us-central1"
      },
      {
        "source": "/functions/unregisterToken",
        "function": "unregisterToken",
        "region": "us-central1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-XSS-Protection", "value": "1; mode=block" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' accounts.google.com apis.google.com checkout.razorpay.com cdn.razorpay.com www.gstatic.com; style-src 'self' 'unsafe-inline' accounts.google.com fonts.googleapis.com; font-src 'self' fonts.gstatic.com data:; img-src 'self' data: *.googleapis.com *.gstatic.com; connect-src 'self' *.googleapis.com *.firebaseapp.com *.firebaseio.com wss://*.firebaseio.com api.razorpay.com accounts.google.com *.run.app *.cloudfunctions.net; frame-src accounts.google.com checkout.razorpay.com api.razorpay.com *.firebaseapp.com; worker-src 'self'; manifest-src 'self'" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/ngsw-worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/ngsw.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          { "key": "Content-Type", "value": "application/manifest+json" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
