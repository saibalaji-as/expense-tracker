{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "../dist-e2e",
    "baseUrl": ".",
    "types": ["node"],
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "./**/*.ts",
    "../playwright.config.ts"
  ],
  "exclude": [
    "../node_modules"
  ]
}
